# original with date string converted to timestamp:
df = spark.read.json("/home/maciej_szczypek/PJATK/master_thesis/python_project/data/source_files/real_vs_liverpool.json").select(to_timestamp(concat(lit("2018-05-27 "), substring(col("created_at"), 12,8))).alias("created_at"), "text", col("user.screen_name").alias("user_name")).filter(col("created_at")>=datetime.datetime(2018, 5, 27, 18, 45, 0)).filter(col("lang")=="en").sample(fraction=1/3)


