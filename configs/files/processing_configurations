analysis_without_emoticons:
  corpus:
    normalization:
      operations:
        lower: true
        remove_commas: false
        remove_stopwords: true
        apply_stemming: false
        apply_lemmatization: true
        expand_contractions: true
        remove_special_characters: true
        remove_emoticons: true
        remove_hashtags: true
        remove_links: true
        remove_user_mentions: true
      custom_data:
        stopwords: null
    tokenization:
      sentence_tokenizer: default_sentence_tokenizer
      word_tokenizer: custom_tokenizer

