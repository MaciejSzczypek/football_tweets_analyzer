setting_1:
  corpus:
    normalization:
      operations:
        remove_stopwords: true
        apply_stemming: false
        apply_lemmatization: false
        expand_contractions: true
        remove_special_characters: false
        remove_emoticons: true
      custom_data:
        stopwords: null
    tokenization:
      sentence_tokenizer: default_sentence_tokenizer
      word_tokenizer: basic_split_by_whitespace_tokenizer

